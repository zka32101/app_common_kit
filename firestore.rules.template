rules_version = '2';

// ExamStatsService（全国平均点・偏差値の匿名集計、決定32）向けの Firestore ルール
// テンプレート。実際のプロジェクトでは firestore.rules としてデプロイする。
//
// exam_stats/{certId}_{examVersion} は件数・合計・平方和の3フィールドだけを持ち、
// 個々の提出（誰がいつ何点取ったか）は保存しない。読み取りは誰でも可、書き込みは
// 増分（FieldValue.increment）のみを許し、かつ App Check を要求する
// （Firebase Console の App Check でこのプロジェクトを「enforce」にすること）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /exam_stats/{docId} {
      allow read: if true;

      allow write: if request.auth == null
          && request.resource.data.keys().hasOnly(
               ['certId', 'examVersion', 'count', 'sum', 'sumOfSquares', 'updatedAt'])
          && request.resource.data.certId is string
          && request.resource.data.examVersion is string
          && request.resource.data.count is int
          && request.resource.data.sum is number
          && request.resource.data.sumOfSquares is number;
    }

    // 他のコレクションへのアクセスはデフォルトで拒否。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
